(provide church-compile
         ; provided conversions:
         church->nat
         church->bool
         church->listof)

;; Input language:
;
; e ::= (letrec ([x (lambda (x ...) e)]) e)    
;     | (let ([x e] ...) e)  
;     | (let* ([x e] ...) e)
;     | (lambda (x ...) e)
;     | (e e ...)    
;     | x  
;     | (and e ...) | (or e ...)
;     | (if e e e)
;     | (prim e) | (prim e e)
;     | datum
; datum ::= nat | (quote ()) | #t | #f 
; nat ::= 0 | 1 | 2 | ... 
; x is a symbol
; prim is a primitive operation in list prims
; The following are *extra credit*: -, =, sub1  
(define prims '(+ * - = add1 sub1 cons car cdr null? not zero?))

; This input language has semantics identical to Scheme / Racket, except:
;   + You will not be provided code that yields any kind of error in Racket
;   + You do not need to treat non-boolean values as #t at if, and, or forms
;   + primitive operations are either strictly unary (add1 sub1 null? zero? not car cdr), 
;                                           or binary (+ - * = cons)
;   + There will be no variadic functions or applications---but any fixed arity is allowed

;; Output language (you must produce a quoted expression satisfying this grammar):
;;
;; e ::= (lambda (x) e)
;;     | (e e)
;;     | x
;;
;; also as interpreted by Racket

;; Decoding to Racket

;; Using the following decoding functions:

; A church-encoded nat is a function taking an f, and x, returning (f^n x)
(define (church->nat c-nat)
  ((c-nat add1) 0))

; A church-encoded bool is a function taking a true-thunk and false-thunk,
;   returning (true-thunk) when true, and (false-thunk) when false
(define (church->bool c-bool)
  ((c-bool (lambda (_) #t)) (lambda (_) #f)))

; A church-encoded cons-cell is a function taking a when-cons callback, and a when-null callback (thunk),
;   returning when-cons applied on the car and cdr elements
; A church-encoded cons-cell is a function taking a when-cons callback, and a when-null callback (thunk),
;   returning the when-null thunk, applied on a dummy value (arbitrary value that will be thrown away)
(define ((church->listof T) c-lst)
  ; when it's a pair, convert the element with T, and the tail with (church->listof T)
  ((c-lst (lambda (a) (lambda (b) (cons (T a) ((church->listof T) b)))))
   ; when it's null, return Racket's null
   (lambda (_) '())))


;; Write your church-compiling code below:

;; (churchify e) churchify recursively walks over e and converts each
;; expression in the input language (defined above, see "input
;; language") to an equivalent (when converted back via each
;; church->XYZ) expression in the lambda calculus (defined above, see
;; "output language")
;;
;; note: both the input and output will be quoted expressions--the
;; test scripts will use Racket's `eval` to turn them into Racket
;; lambdas.

(define (nat->church n)
  (define (helper n) (match n [0 'x] [_ `(f ,(helper (- n 1)))]))
  `(lambda (f) (lambda (x) ,(helper n))))

(define (churchify e)
  (match e
    [(? nonnegative-integer? n)
     ;; I want to return the λ-calculus encoding of this n
     (nat->church n)]
    
    ;; === Recursive function using Y combinator ===
    [`(letrec ([,f (lambda (,args ...) ,body)]) ,e1)
     (churchify
      `((lambda (,f) ,e1)
        ((lambda (f)
           ((lambda (x) (f (lambda (v) ((x x) v))))
            (lambda (x) (f (lambda (v) ((x x) v))))))
         (lambda (,f)
           ,(foldr (λ (a b) `(lambda (,a) ,b))
                   (churchify body) args)))))]

    ;; === Simple let => lambda application ===
    [`(let ([,xs ,es] ...) ,body)
     `((lambda ,xs ,(churchify body)) ,@(map churchify es))]

    ;; === let* desugaring ===
    [`(let* () ,body) (churchify body)]
    [`(let* ([,x ,e0] ,rest ...) ,body)
     (churchify `(let ([,x ,e0]) (let* ,rest ,body)))]

    ;; === Lambda abstraction ===
    [`(lambda (,args ...) ,body)
     (foldr (λ (a b) `(lambda (,a) ,b)) (churchify body) args)]

    ;; === Logical AND ===
    [`(and) (churchify #t)]
    [`(and ,e) `((,(churchify e)) ,(churchify #t) ,(churchify #f))]
    [`(and ,e0 ,rest ...) (churchify `(if ,e0 (and ,@rest) #f))]

    ;; === Logical OR ===
    [`(or) (churchify #f)]
    [`(or ,e) `((,(churchify e)) ,(churchify #t) ,(churchify #f))]
    [`(or ,e0 ,rest ...) (churchify `(if ,e0 #t (or ,@rest)))]

    ;; === If expression using Church booleans ===
    [`(if ,e1 ,e2 ,e3)
     `(((,(churchify e1)) ,(churchify e2)) ,(churchify e3))]

    ;; === Function application (variadic) ===
    [`(,f ,args ...)
     (foldl (λ (a b) `(,a ,b))
            (churchify f)
            (map churchify args))]

    ;; === Empty list => Church nil ===
    ['() '(lambda (f) (lambda (x) x))]

    ;; === Church booleans ===
    [#t '(lambda (x) (lambda (y) x))]
    [#f '(lambda (x) (lambda (y) y))]
    
    ;; === Variable ===
    [(? symbol? x) x]

    ;; === Church numerals ===
    [(? number? n)
     (printf "[DEBUG] Churchifying number: ~a\n" n)
     `(lambda (f) (lambda (x)
        ,(for/fold ([r 'x]) ([i (in-range n)]) `(f ,r))))]
    [_ (error "Unhandled expression: ~a" e)]))


; Takes a whole program in the input language, and converts it into an equivalent program in lambda-calc
(define (church-compile prog)
  (define prims
    `([+ ,(λ (m) (λ (n) (λ (f) (λ (x) ((m f) ((n f) x))))))]
      [* ,(λ (m) (λ (n) (λ (f) (m (n f)))))]
      [add1 ,(λ (n) (λ (f) (λ (x) (f ((n f) x)))))]
      [sub1 ,(λ (n) (λ (f) (λ (x) (((n (λ (g) (λ (h) (h (g f))))) (λ (_) x)) (λ (_) _)))))]
      [- ,(λ (m) (λ (n) ((n (λ (p) (λ (f) (λ (x) (((p (λ (g) (λ (h) (h (g f))))) (λ (_) x)) (λ (_) _))))) m))))]
      [= ,(λ (m) (λ (n) (((λ (x) ((x (λ (a) (λ (b) a))) (λ (a) (λ (b) b)))) (and ((zero? (- m n)) (zero? (- n m))))))))]
      [zero? ,(λ (n) ((n (λ (_) (λ (a) (λ (b) b)))) (λ (a) (λ (b) a))))]
      [not ,(λ (b) ((b (λ (x) (λ (y) y))) (λ (x) (λ (y) x))))]
      [cons ,(λ (a) (λ (d) (λ (f) ((f a) d))))]
      [car ,(λ (p) (p (λ (a) (λ (d) a))))]
      [cdr ,(λ (p) (p (λ (a) (λ (d) d))))]
      [null? ,(λ (p) (p (λ (h) (λ (t) (λ (x) (λ (y) y)))) (λ (x) (λ (y) x))))]))
  (churchify `(let ,prims ,prog)))




;; === Primitive Lambda Definitions ===
(define church-true  '(lambda (x) (lambda (y) x)))
(define church-false '(lambda (x) (lambda (y) y)))

(define prim-+    '(lambda (m) (lambda (n) (lambda (f) (lambda (x) ((m f) ((n f) x)))))))
(define prim-*    '(lambda (m) (lambda (n) (lambda (f) (m (n f))))))
(define prim-sub1 '(lambda (n) (lambda (f) (lambda (x) (((n (lambda (g) (lambda (h) (h (g f))))) (lambda (u) x)) (lambda (u) u))))))
(define prim--    `(lambda (m) (lambda (n) ((n ,prim-sub1) m))))
(define prim-=    `(lambda (m) (lambda (n) ((and (zero? (- m n)) (zero? (- n m))) ,church-true ,church-false))))
(define prim-add1 '(lambda (n) (lambda (f) (lambda (x) (f ((n f) x))))))
(define prim-cons '(lambda (x) (lambda (y) (lambda (f) ((f x) y)))))
(define prim-car  '(lambda (p) (p (lambda (x) (lambda (y) x)))))
(define prim-cdr  '(lambda (p) (p (lambda (x) (lambda (y) y)))))
(define prim-null? `(lambda (p) (p (lambda (h) (lambda (t) ,church-false)) ,church-true)))
(define prim-not    `(lambda (b) ((b ,church-false) ,church-true)))
(define prim-zero?  `(lambda (n) ((n (lambda (x) ,church-false)) ,church-true)))

;; === Type-aware Unchurch ===

(define (unchurch v type)
  (match type
    ['bool (((v (lambda () #t)) (lambda () #f)))]
    ['nat  ((v add1) 0)]
    ['list ((church->listof identity) v)]
    [_     (error "Unknown type: ~a" type)]))


;; === Inject Primitives Into Scope ===
(define (with-prims expr)
  `(let ([+ ,prim-+]
         [* ,prim-*]
         [- ,prim--]
         [= ,prim-=]
         [add1 ,prim-add1]
         [sub1 ,prim-sub1]
         [cons ,prim-cons]
         [car ,prim-car]
         [cdr ,prim-cdr]
         [null? ,prim-null?]
         [not ,prim-not]
         [zero? ,prim-zero?]
         [church-true ,church-true]
         [church-false ,church-false])
     ,expr))

;; === Church Compiler ===

(define (church-encode program)
  (churchify (with-prims program)))

;; === Test Runner ===

(define (run-test input expected type)
  (define compiled (churchify (with-prims input)))
  (define value (eval compiled (make-base-namespace)))
  (define result (unchurch value type))
  (define pass? (equal? result expected))
  (printf "=== TEST ===\n")
  (printf "Input:       ~s\n" input)
  (printf "Churchified: ~s\n" compiled)
  (printf "Unchurch:    ~s\n" result)
  (printf "Expected:    ~s\n" expected)
  (printf "Result:      ~a\n\n" (if pass? "PASS" "FAIL"))
  pass?)

;; === Tests ===
(define test-cases
  '(    
    ;; NATURALS
    (0                          0   nat)
    (1                          1   nat)
    (2                          2   nat)

    ;; BOOLEANS
    (#t                         #t  bool)
    (#f                         #f  bool)

    ;; PRIMITIVES
    ((not #t)                   #f  bool)
    ((not #f)                   #t  bool)

    ;; IF
    ((if #t 1 2)                1   nat)
    ((if #f 1 2)                2   nat)
    
    ((add1 0)                   1   nat)
    ((sub1 2)                   1   nat)

    ((+ 1 2)                    3   nat)
    ((* 2 3)                    6   nat)
    ((- 4 2)                    2   nat)

    ((zero? 0)                  #t  bool)
    ((zero? 1)                  #f  bool)

    ;; LIST OPS
    ((null? '())                #t  bool)
    ((car (cons 1 2))           1   nat)
    ((cdr (cons 1 2))           2   nat)

    ;; LOGICAL COMBOS
    ((and #t #t)                #t  bool)
    ((and #t #f)                #f  bool)
    ((or #f #t)                 #t  bool)
    ((or #f #f)                 #f  bool)

    ;; BASIC LAMBDA
    (((lambda (x) x) 1)         1   nat)

    ;; APPLICATION AND SCOPE
    (((lambda (x) (+ x 1)) 2)   3   nat)
    (((lambda (x) ((lambda (y) (* x y)) (+ x 1))) 1) 2 nat)
  ))

(define passed-tests
  (count identity (map (λ (t) (apply run-test t)) test-cases)))

(printf "~a/~a tests passed\n" passed-tests (length test-cases))
